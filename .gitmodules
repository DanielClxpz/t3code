# Vendored gitlinks need root mappings for checkout's credential cleanup.
# They are reference material and are never initialized by custom CI.
[submodule "reference-distilled"]
	path = .repos/alchemy-effect/submodules/distilled
	url = https://github.com/alchemy-run/distilled.git
	update = none
[submodule "reference-floci"]
	path = .repos/alchemy-effect/submodules/floci
	url = https://github.com/alchemy-run/floci.git
	update = none
